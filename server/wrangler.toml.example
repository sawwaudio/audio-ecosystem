# 課金の確認サーバー（Cloudflare Workers）の設定。wrangler.toml という名前で写して使う。
# 秘密の値（Stripe の鍵など）はここに書かない。`npx wrangler secret put 名前` で入れる（server/README.md）。
name = "saww-billing"
main = "worker.js"
compatibility_date = "2026-11-01"

[vars]
APP_URL = "https://sawwaudio.github.io/audio-ecosystem-sounds-1/"
ALLOWED_ORIGINS = "https://sawwaudio.github.io"
# PRO として認める Stripe の価格 ID（price_…）。空なら有効な定期購読はすべて PRO
PRICE_IDS = ""

[[kv_namespaces]]
binding = "SAWW_KV"
id = "ここに npx wrangler kv namespace create SAWW_KV で出た id"

# v0.68 利用の記録・Readdy のデモ生成の列（server/growth）。D1 を使う。無ければ /api/usage/events などは 503 を返すだけ。
# 作り方：npx wrangler d1 create saww-usage → 出た database_id を下に。表は npx wrangler d1 execute saww-usage --remote --file=growth/schema.sql
# 秘密：READDY_DEMO_KEY（Readdy からの依頼用）・RENDER_SERVICE_KEY（描く機械用）は npx wrangler secret put で入れる
# [[d1_databases]]
# binding = "USAGE_DB"
# database_name = "saww-usage"
# database_id = "ここに npx wrangler d1 create saww-usage で出た id"
